# Debug Workflow Environment Configuration
# Copy this file to .env.debug and fill in your values
#
# Required for local debug bundle collection and testing
# Bead: entropy-wiki-1ns

# ============================================
# GitHub Actions Collector
# ============================================
# Personal access token with 'actions:read' scope
# Get one at: https://github.com/settings/tokens
# Required scopes: repo (for private repos), actions:read
GITHUB_TOKEN=ghp_xxxx

# Repository information (auto-detected in GitHub Actions)
# Format: owner/repo
GITHUB_REPOSITORY=Entropic-Systems/entropy-wiki
GITHUB_REPOSITORY_OWNER=Entropic-Systems

# ============================================
# Railway Collector
# ============================================
# Railway API token for deployment monitoring
# Get one at: https://railway.app/account/tokens
RAILWAY_TOKEN=your-railway-token

# Railway project and service IDs (optional, for scoping)
# Find these in your Railway dashboard URL
# RAILWAY_PROJECT_ID=your-project-id
# RAILWAY_ENVIRONMENT_ID=production

# ============================================
# Vercel Collector
# ============================================
# Vercel API token for deployment monitoring
# Get one at: https://vercel.com/account/tokens
VERCEL_TOKEN=your-vercel-token

# Vercel project and team IDs (optional, for scoping)
# Find these in your Vercel dashboard
# VERCEL_PROJECT_ID=prj_xxxx
# VERCEL_TEAM_ID=team_xxxx

# ============================================
# API Health Collector
# ============================================
# Base URL for API health checks
# Default: http://localhost:3001 (local development)
API_BASE_URL=http://localhost:3001

# ============================================
# Debug Bundle Settings
# ============================================
# Output directory for debug bundles
DEBUG_BUNDLE_OUTPUT=./debug-bundle

# Default collection mode: 'logs' | 'full'
DEBUG_BUNDLE_MODE=logs

# Default lookback window: '30m' | '2h' | '1d' | '7d'
DEBUG_BUNDLE_LOOKBACK=2h

# ============================================
# Rate Limiting & Quotas
# ============================================
# GitHub API rate limit (unauthenticated: 60/hour, authenticated: 5000/hour)
# GITHUB_RATE_LIMIT=5000

# Vercel API has no official rate limit, but be reasonable
# VERCEL_RATE_LIMIT=100

# Railway API rate limit
# RAILWAY_RATE_LIMIT=100

# ============================================
# Timeouts & Retries
# ============================================
# Default timeout for API calls (ms)
COLLECTOR_TIMEOUT_MS=30000

# Number of retry attempts for failed requests
COLLECTOR_RETRY_ATTEMPTS=3

# Delay between retries (ms)
COLLECTOR_RETRY_DELAY_MS=1000
