# Database connection
# Local: docker compose up -d provides this default
# Production: Set your actual PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/entropy_wiki

# Server configuration
PORT=3001

# CORS origins (comma-separated for multiple)
# Local development default
CORS_ORIGINS=http://localhost:3000

# Admin password (REQUIRED - set your own secure password)
# Used for all /admin/* endpoints
#
# For development:
ADMIN_PASSWORD=your-secure-password-here
#
# For production, use bcrypt hash instead:
# Generate with: node -e "require('bcrypt').hash('yourpassword', 10).then(console.log)"
# ADMIN_PASSWORD_HASH=$2b$10$...

# Optional: GitHub token for ingesting content from private repos
# Get one at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxx
